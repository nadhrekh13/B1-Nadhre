MIN_LENGTH = 8
SPECIAL_CHARS = "!@#$%^&*()-_+=[]{}|;:,.<>?/~`"

def check_password_length(password):
    length = len(password)
    is_ok = MIN_LENGTH <= length
    message = (
        f"✅ Password length is good: {length} characters."
        if is_ok else
        f"❌ Password is too short. It must be at least {MIN_LENGTH} characters long (current: {length})."
    )
    return is_ok, message

def check_password_complexity(password):
    has_lowercase = False
    has_uppercase = False
    has_digit = False
    has_special = False

    for ch in password:
        if ch.islower():
            has_lowercase = True
        elif ch.isupper():
            has_uppercase = True
        elif ch.isdigit():
            has_digit = True
        elif ch in SPECIAL_CHARS:
            has_special = True
        # early exit if all found
        if has_lowercase and has_uppercase and has_digit and has_special:
            break

    checks = {
        "min_length": len(password) >= MIN_LENGTH,
        "has_lowercase": has_lowercase,
        "has_uppercase": has_uppercase,
        "has_digit": has_digit,
        "has_special": has_special,
    }
    checks["is_valid"] = all(checks.values())
    return checks

def main():
    print("=" * 50)
    print("PASSWORD STRENGTH VALIDATOR")
    print("=" * 50)
    print("\nPassword Requirements:")
    print(f"Minimum {MIN_LENGTH} characters")
    print("At least one uppercase letter")
    print("At least one lowercase letter")
    print("At least one digit")
    print("At least one special character (!@#$%^&* etc.)")
    print()

    password = input("Enter your new password: ")

    # Length check (optional separate message)
    is_length_ok, length_msg = check_password_length(password)
    print("\n--- Validation Result ---")
    print(length_msg)
    print()

    checks = check_password_complexity(password)

    print("\n" + "=" * 50)
    print("VALIDATION RESULTS")
    print("=" * 50)
    print(f"{'✅' if checks['min_length'] else '❌'} Minimum length ({MIN_LENGTH}+ chars): {checks['min_length']}")
    print(f"{'✅' if checks['has_uppercase'] else '❌'} Contains uppercase: {checks['has_uppercase']}")
    print(f"{'✅' if checks['has_lowercase'] else '❌'} Contains lowercase: {checks['has_lowercase']}")
    print(f"{'✅' if checks['has_digit'] else '❌'} Contains digit: {checks['has_digit']}")
    print(f"{'✅' if checks['has_special'] else '❌'} Contains special char: {checks['has_special']}")
    print("\n" + "=" * 50)
    if checks['is_valid']:
        print("✅ PASSWORD IS STRONG!")
    else:
        print("❌ PASSWORD IS WEAK - Please address failed requirements")
        print("=" * 50)

if __name__ == "__main__":
    main()
