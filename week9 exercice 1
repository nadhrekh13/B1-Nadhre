from datetime import datetime
from dataclasses import dataclass, field
from typing import List, Dict, Optional

@dataclass
class Device:
    _device_id: str
    _device_type: str
    _owner: str
    _firmware_version: str = '1.0.0'
    _compliance_status: str = 'unknown'
    _last_security_scan: Optional[datetime] = None
    _is_active: bool = True
    _access_log: List[str] = field(default_factory=list)

    def authorise_access(self, user) -> bool:
        # Check if device is active
        if not self._is_active:
            self._log_action(user.get_username(), 'Denied - Device inactive')
            return False

        # Admin bypass or compliance check
        is_admin = user.check_privileges('admin')
        if self._compliance_status != 'compliant' and not is_admin:
            self._log_action(user.get_username(), 'Denied - Non-compliant device')
            return False

        # Owner or Admin check
        if self._owner != user.get_username() and not is_admin:
            self._log_action(user.get_username(), 'Denied - Not owner')
            return False

        self._log_action(user.get_username(), 'Access granted')
        return True

    def run_security_scan(self):
        self._last_security_scan = datetime.now()
        self._compliance_status = 'compliant' # Simulate scan logic
        self._log_action('SYSTEM', 'Security scan completed')

    def check_compliance(self) -> bool:
        if self._last_security_scan is None:
            self._compliance_status = 'unknown'
            return False
        return self._compliance_status == 'compliant'

    def update_firmware(self, version: str, user) -> bool:
        if user.check_privileges('admin'):
            self._firmware_version = version
            self._log_action(user.get_username(), f'Firmware updated to {version}')
            return True
        return False

    def quarantine(self, user) -> bool:
        if user.check_privileges('admin'):
            self._is_active = False
            self._log_action(user.get_username(), 'Device quarantined')
            return True
        return False

    def _log_action(self, username: str, action: str):
        self._access_log.append(f"{datetime.now()}: {username} - {action}")

    def get_device_info(self) -> dict:
        return {
            'device_id': self._device_id,
            'device_type': self._device_type,
            'firmware_version': self._firmware_version,
            'compliance_status': self._compliance_status,
            'owner': self._owner,
            'is_active': self._is_active
        }

class DeviceManager:
    def __init__(self):
        self.__devices: Dict[str, Device] = {}

    def add_device(self, device: Device):
        info = device.get_device_info()
        self.__devices[info['device_id']] = device

    def remove_device(self, device_id: str, user) -> bool:
        if user.check_privileges('admin') and device_id in self.__devices:
            del self.__devices[device_id]
            return True
        return False

    def generate_security_report(self, user) -> Optional[List[dict]]:
        if not user.check_privileges('admin'):
            return None
        
        # Trigger compliance check before reporting
        for dev in self.__devices.values():
            dev.check_compliance()
            
        return [dev.get_device_info() for dev in self.__devices.values()]
